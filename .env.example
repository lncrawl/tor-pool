# Copy to .env and edit. Defaults live in internal/config/config.go — that file
# is the source of truth, not this one.

# --- Pool -------------------------------------------------------------------

# Number of tor instances. Each is an independent exit identity; more instances
# means more concurrent exit IPs and more memory (~30-40 MB per instance).
POOL_SIZE=5

# Start serving once this many instances have bootstrapped, rather than waiting
# for all of them.
MIN_READY=1

# Delay between spawning instances at boot and on a resize, so N simultaneous
# consensus fetches do not compete for CPU and sockets.
SPAWN_STAGGER=500ms

# Restart an instance that has made no bootstrap progress for this long. Tor can
# wedge part-way through with a live process, which nothing else notices: the
# supervisor sees a running tor and an instance that takes no traffic reports no
# failures, so the pool silently runs under strength. Set to 0 to disable.
BOOTSTRAP_STALL_TIMEOUT=3m

# --- Authentication ---------------------------------------------------------

# The operator's dashboard login. Leave ADMIN_PASSWORD unset and a password is
# generated on first boot and printed once to the log; set it here to choose your
# own. A password you set is never written to disk.
ADMIN_USER=admin
ADMIN_PASSWORD=

# How long a dashboard session lasts before it has to sign in again. There is no
# refresh token, so this is the whole lifetime.
LOGIN_TTL=24h

# Wrong passwords allowed per minute from one address. 0 disables the limit.
# Behind a reverse proxy every caller looks like the proxy, so the limit becomes
# global rather than per-client.
LOGIN_RATE_LIMIT=10

# A proxy credential fixed by configuration, for deployments provisioned from
# files rather than from the dashboard. It must start with tp_. Left empty, the
# first boot issues one and prints it, and further tokens are minted in the
# dashboard's Tokens tab.
#
# The token is the *password* on a proxy URL; the username stays the session key:
#   socks5h://my-session:tp_xxxxxxxxxxxxxxxxxxxxxx@127.0.0.1:9250
PROXY_TOKEN=

# --- Sessions ---------------------------------------------------------------

# A caller is pinned to one instance for the life of its session. The session
# key is the SOCKS5 username (or the Proxy-Authorization user over HTTP).
# This setting decides what happens when a caller names no session:
#   ip     - pin per client IP
#   random - a fresh instance per connection, nothing is sticky
#   shared - every such caller shares one session
DEFAULT_SESSION=ip

# Unpin a session after this long with no traffic.
SESSION_TTL=10m

# Move the sessions pinned to an instance onto another one when that instance is
# rotated, instead of leaving them on it while it throws its circuits away.
# Turn it off when stickiness matters more than the exit, e.g. a login the target
# site has tied to one IP.
DRAIN_ON_ROTATE=true

# --- Health and remediation -------------------------------------------------

# Failures are counted per instance over a sliding window, from two sources:
# transport errors seen by the balancer, and failures reported by clients via
# POST /api/sessions/{key}/failure (the only signal that catches soft blocks
# like 403 or a captcha, which are invisible inside an HTTPS tunnel).
FAILURE_WINDOW=1m
QUARANTINE_FAILURES=5
QUARANTINE_CONSECUTIVE=3

# A quarantined instance escalates: new circuit, then a restart with wiped
# state, then restarts with growing backoff.
ESCALATION_WINDOW=5m
REMEDIATION_BACKOFF=30s
MAX_REMEDIATION_BACKOFF=10m

# --- Circuit policy ---------------------------------------------------------

# Restrict exit selection, e.g. TOR_EXIT_NODES={us},{ca} or
# TOR_EXCLUDE_EXIT_NODES={ru},{cn}. Leave empty for tor's default choice.
# Narrow policies shrink the usable relay set and slow circuit building.
TOR_EXIT_NODES=
TOR_EXCLUDE_EXIT_NODES=
TOR_STRICT_NODES=false

# How long an instance may reuse a circuit, and therefore how long its exit IP
# stays put. Tor's own default is 10 minutes, which would change the exit under
# a caller that never asked to rotate — so this is deliberately much longer.
# Shorten it if you would rather have unlinkability than a stable identity.
TOR_MAX_CIRCUIT_DIRTINESS=1h

# Tor's multipath circuits. Off here, unlike in tor itself: every conflux set it
# pre-builds has its own exit relay and successive requests land on different
# sets, so one instance handed a caller several exit IPs without any rotation.
TOR_CONFLUX=false

# Lock each instance to a single exit relay, so one instance really is one exit
# IP for as long as it is not rotated. Without it tor spreads requests across
# whichever exit circuits it happens to hold, and a pinned session's IP can
# change under it. The trade is that the instance then depends on one relay: if
# that relay is slow or rejects the traffic, every request on the instance
# suffers until the failure ladder moves it.
PIN_EXIT_RELAY=false

# Extra torrc lines appended to every instance, for options not modelled above.
TOR_EXTRA_CONFIG=

# --- Listeners --------------------------------------------------------------

# Ports inside the container. Set HTTP_PORT= (empty) to disable the HTTP proxy.
SOCKS_PORT=9250
HTTP_PORT=9251
API_PORT=8080

# --- Host publishing --------------------------------------------------------

# Used by compose.yml. Authentication is defence in depth, not a substitute for
# TLS: passwords, tokens and session credentials all cross the wire in cleartext,
# so keep these on loopback unless something terminating TLS sits in front.
SOCKS_PUBLISH=127.0.0.1:9250
HTTP_PUBLISH=127.0.0.1:9251
API_PUBLISH=127.0.0.1:8080

# --- Logging ----------------------------------------------------------------

# debug | info | warn | error. debug includes tor's own notice lines.
LOG_LEVEL=info
